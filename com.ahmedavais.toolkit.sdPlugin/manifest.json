{
	"Name": "Ahmed's Toolkit",
	"Version": "0.2.0.0",
	"Author": "Ahmed Avais",
	"Actions": [
		{
			"Name": "Usage Gauge",
			"UUID": "com.ahmedavais.toolkit.claude.usage-gauge",
			"Icon": "imgs/actions/usage-gauge/icon",
			"Tooltip": "Shows Claude Code rate-limit utilization.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/usage-gauge/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Active Task",
			"UUID": "com.ahmedavais.toolkit.claude.active-task",
			"Icon": "imgs/actions/active-task/icon",
			"Tooltip": "Shows elapsed time for your longest-running Claude Code session. Press to bring its app to the front.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/active-task/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "MCP Status",
			"UUID": "com.ahmedavais.toolkit.claude.mcp-status",
			"Icon": "imgs/actions/mcp-status/icon",
			"Tooltip": "Shows MCP server health. Press to re-check now.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/mcp-status/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Needs Attention",
			"UUID": "com.ahmedavais.toolkit.claude.needs-attention",
			"Icon": "imgs/actions/needs-attention/icon",
			"Tooltip": "Lights up when a Claude Code session waits for your approval or reply.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/needs-attention/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Start Session",
			"UUID": "com.ahmedavais.toolkit.claude.start-session",
			"Icon": "imgs/actions/start-session/icon",
			"Tooltip": "Starts a new Claude Code session in the Claude desktop app, in the project folder you choose.",
			"PropertyInspectorPath": "ui/start-session.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/start-session/key",
					"Title": "New session",
					"TitleAlignment": "bottom"
				}
			]
		}
	],
	"Category": "Ahmed's Toolkit",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"Description": "Ahmed's custom Stream Deck actions, including live Claude Code status.",
	"Icon": "imgs/plugin/plugin",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.ahmedavais.toolkit"
}